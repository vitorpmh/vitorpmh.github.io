<div class="about-publications">
  <ul class="nav nav-pills about-publications-nav mb-3" role="tablist">
    <li class="nav-item">
      <a
        class="nav-link active"
        id="selected-pubs-tab"
        data-toggle="tab"
        href="#selected-pubs"
        role="tab"
        aria-controls="selected-pubs"
        aria-selected="true"
      >
        Selected Publications
      </a>
    </li>
    <li class="nav-item">
      <a
        class="nav-link"
        id="other-pubs-tab"
        data-toggle="tab"
        href="#other-pubs"
        role="tab"
        aria-controls="other-pubs"
        aria-selected="false"
      >
        Other Publications
      </a>
    </li>
  </ul>

  <div class="tab-content">
    <div class="tab-pane fade show active" id="selected-pubs" role="tabpanel" aria-labelledby="selected-pubs-tab">
      {% include selected_papers.liquid %}
    </div>
    <div class="tab-pane fade" id="other-pubs" role="tabpanel" aria-labelledby="other-pubs-tab">
      {% include other_papers.liquid %}
    </div>
  </div>
</div>
